# OpenSSH sshd fixture for Dromon's integration tests: Debian trixie's PAM-enabled OpenSSH.
# Built and started by `crates/dromon-testkit` (testcontainers); see README.md.
# sftp-server here advertises posix-rename@openssh.com, limits@openssh.com and copy-data.
#
# Users (see sshd_config and pam-sshd for how each one logs in):
#   key    public key (id_ed25519), no password; owns the seed data
#   pw     password "dromon-test-pw" (SSH "password" method, through PAM)
#   kbd    keyboard-interactive through PAM: "Password: " (dromon-test-pw), then
#          "Verification code: " (TOTP, libpam-google-authenticator, secret in google_authenticator)
#   keypw  two methods: public key (id_ed25519_enc) then password "dromon-test-pw"
#   enc    public key with an encrypted private key (id_ed25519_enc, passphrase
#          "dromon-test-passphrase"), no password
# The keypairs are generated by the test process and copied into the container before it starts
# (/keys/*.pub), so no key is part of the image. Passwords and the TOTP secret are fixed test
# values; the testkit publishes the ports on 127.0.0.1 only.
# Docker Hub's official image through Google's mirror: CI runners share Docker Hub's anonymous
# pull limit (429 Too Many Requests); the mirror serves the same images without it.
FROM mirror.gcr.io/library/debian:trixie-slim

# useradd leaves the password "!" (locked), which sshd refuses even for public keys; "*" only
# disables passwords.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        openssh-server openssh-sftp-server libpam-google-authenticator socat \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* /etc/ssh/sshd_config.d \
    && for u in key pw kbd keypw enc; do useradd -m -s /bin/sh "$u"; done \
    && usermod -p '*' key && usermod -p '*' enc \
    && mkdir /keys \
    && printf 'pw:dromon-test-pw\nkbd:dromon-test-pw\nkeypw:dromon-test-pw\n' | chpasswd

COPY sshd_config /etc/ssh/sshd_config
COPY pam-sshd /etc/pam.d/sshd
COPY --chown=kbd:kbd --chmod=400 google_authenticator /home/kbd/.google_authenticator
COPY --chmod=755 entrypoint.sh seed.sh /usr/local/bin/

# 22: sshd. 9999: the lifeline (see entrypoint.sh).
EXPOSE 22 9999
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
