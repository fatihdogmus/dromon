Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
AllowUsers key pw kbd enc
# Integration tests open one connection per test, in parallel.
MaxStartups 100:30:200
MaxSessions 50
Subsystem sftp /usr/lib/ssh/sftp-server
LogLevel INFO

# Alpine's sshd is built without PAM, so it has no keyboard-interactive devices (auth2-chall.c
# only knows BSD auth and PAM): keyboard-interactive can't work here. The two-factor user uses
# public key then password instead. `enc` and `key` keep the global public-key-only settings.

# Password only. Prompt: "pw@<host>'s password: ".
Match User pw
    PasswordAuthentication yes
    PubkeyAuthentication no
    AuthenticationMethods password

# Public key, then password. With the encrypted key the client asks
# "Enter passphrase for key '<path>': ", then "kbd@<host>'s password: ".
Match User kbd
    PasswordAuthentication yes
    AuthenticationMethods publickey,password
